{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "cae84f77e7d582aa16636f469efbc23b09f06e9b",
  "include-component-in-tag": false,
  "plugins": [
    {
      "type": "cargo-workspace",
      "merge": false
    },
    {
      "type": "linked-versions",
      "groupName": "anybuild",
      "components": [
        "v"
      ]
    }
  ],
  "packages": {
    ".": {
      "component": "v",
      "draft": true,
      "include-component-in-tag": true,
      "include-v-in-tag": false,
      "release-type": "rust",
      "tag-separator": ""
    },
    "crates/anybuild": {
      "component": "v",
      "include-component-in-tag": true,
      "include-v-in-tag": false,
      "release-type": "rust",
      "skip-changelog": true,
      "skip-github-release": true,
      "tag-separator": ""
    },
    "crates/anybuild-cli": {
      "component": "v",
      "include-component-in-tag": true,
      "include-v-in-tag": false,
      "release-type": "rust",
      "skip-changelog": true,
      "skip-github-release": true,
      "tag-separator": ""
    }
  }
}
