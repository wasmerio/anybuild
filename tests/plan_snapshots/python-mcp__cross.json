{
 "build": [
  {
   "__type__": "UseStep",
   "dependencies": [
    {
     "architecture": null,
     "name": "python",
     "version": "3.13"
    },
    {
     "architecture": null,
     "name": "uv",
     "version": "0.8.15"
    }
   ]
  },
  {
   "__type__": "WorkdirStep",
   "path": "app"
  },
  {
   "__type__": "EnvStep",
   "variables": {
    "UV_PROJECT_ENVIRONMENT": "opt/local_venv",
    "UV_PYTHON": "python3.13",
    "UV_PYTHON_PREFERENCE": "only-system"
   }
  },
  {
   "__type__": "RunStep",
   "command": "uv sync --locked",
   "group": "install",
   "inputs": [
    "pyproject.toml",
    "uv.lock",
    "README.md"
   ],
   "outputs": null
  },
  {
   "__type__": "CopyStep",
   "base": "source",
   "ignore": null,
   "source": "pyproject.toml",
   "target": "pyproject.toml"
  },
  {
   "__type__": "RunStep",
   "command": "uv add mcp[cli]",
   "group": "install",
   "inputs": null,
   "outputs": null
  },
  {
   "__type__": "RunStep",
   "command": "uv pip compile pyproject.toml --universal --extra-index-url None --index-url=https://pypi.org/simple --emit-index-url --no-deps -o cross-requirements.txt",
   "group": null,
   "inputs": null,
   "outputs": [
    "cross-requirements.txt"
   ]
  },
  {
   "__type__": "RunStep",
   "command": "uvx pip install -r cross-requirements.txt mcp[cli] --target opt/venv/lib/python3.13/site-packages --platform wasix_wasm32 --only-binary=:all: --python-version=3.13 --compile",
   "group": null,
   "inputs": null,
   "outputs": null
  },
  {
   "__type__": "RunStep",
   "command": "rm cross-requirements.txt",
   "group": null,
   "inputs": null,
   "outputs": null
  },
  {
   "__type__": "PathStep",
   "path": "opt/local_venv/bin"
  },
  {
   "__type__": "CopyStep",
   "base": "source",
   "ignore": [
    ".venv",
    ".git",
    "__pycache__"
   ],
   "source": ".",
   "target": "."
  },
  {
   "__type__": "RunStep",
   "command": "mkdir -p opt/venv/bin",
   "group": null,
   "inputs": null,
   "outputs": null
  },
  {
   "__type__": "RunStep",
   "command": "cp opt/local_venv/bin/mcp opt/venv/bin/mcp",
   "group": null,
   "inputs": null,
   "outputs": null
  }
 ],
 "commands": {
  "start": "python main.py"
 },
 "cwd": "app",
 "deps": [
  "python@3.13"
 ],
 "env": {
  "FASTMCP_HOST": "0.0.0.0",
  "FASTMCP_PORT": "8080",
  "HOME": "app",
  "PYTHONPATH": "app:opt/venv/lib/python3.13/site-packages"
 },
 "mounts": [
  {
   "build_path": "app",
   "name": "app",
   "serve_path": "app"
  },
  {
   "build_path": "opt/venv",
   "name": "venv",
   "serve_path": "opt/venv"
  }
 ],
 "name": "python-mcp",
 "prepare": [
  {
   "__type__": "RunStep",
   "command": "echo \"Precompiling Python code...\"",
   "group": null,
   "inputs": null,
   "outputs": null
  },
  {
   "__type__": "RunStep",
   "command": "python -m compileall -o 2 opt/venv/lib/python3.13/site-packages || true",
   "group": null,
   "inputs": null,
   "outputs": null
  },
  {
   "__type__": "RunStep",
   "command": "echo \"Precompiling package code...\"",
   "group": null,
   "inputs": null,
   "outputs": null
  },
  {
   "__type__": "RunStep",
   "command": "python -m compileall -o 2 app || true",
   "group": null,
   "inputs": null,
   "outputs": null
  }
 ],
 "provider": "python",
 "services": [],
 "volumes": []
}
