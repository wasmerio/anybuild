{
 "build": [
  {
   "__type__": "UseStep",
   "dependencies": [
    {
     "architecture": null,
     "name": "hugo",
     "version": "0.153.2"
    }
   ]
  },
  {
   "__type__": "WorkdirStep",
   "path": "opt/temp"
  },
  {
   "__type__": "CopyStep",
   "base": "source",
   "ignore": [
    ".git"
   ],
   "source": ".",
   "target": "."
  },
  {
   "__type__": "RunStep",
   "command": "hugo build --gc --minify",
   "group": "build",
   "inputs": null,
   "outputs": null
  },
  {
   "__type__": "RunStep",
   "command": "cp -R public/* opt/static_app/",
   "group": null,
   "inputs": null,
   "outputs": null
  }
 ],
 "commands": {
  "start": "static-web-server --root=opt/static_app --log-level=info --port=8080"
 },
 "cwd": null,
 "deps": [
  "static-web-server@2.38.0"
 ],
 "env": {},
 "mounts": [
  {
   "build_path": "opt/static_app",
   "name": "static_app",
   "serve_path": "opt/static_app"
  }
 ],
 "name": "hugo",
 "prepare": [],
 "provider": "hugo",
 "services": [],
 "volumes": []
}
