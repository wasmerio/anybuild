{
 "build": [
  {
   "__type__": "UseStep",
   "dependencies": [
    {
     "architecture": null,
     "name": "python",
     "version": "3.13"
    },
    {
     "architecture": null,
     "name": "uv",
     "version": "0.8.15"
    }
   ]
  },
  {
   "__type__": "WorkdirStep",
   "path": "app"
  },
  {
   "__type__": "EnvStep",
   "variables": {
    "UV_PROJECT_ENVIRONMENT": "opt/local_venv"
   }
  },
  {
   "__type__": "RunStep",
   "command": "uv init",
   "group": "install",
   "inputs": [],
   "outputs": [
    "uv.lock"
   ]
  },
  {
   "__type__": "RunStep",
   "command": "uv add -r requirements.txt ",
   "group": "install",
   "inputs": [
    "requirements.txt"
   ],
   "outputs": null
  },
  {
   "__type__": "RunStep",
   "command": "uv pip compile requirements.txt --python-version=3.13 --universal --extra-index-url None --index-url=https://pypi.org/simple --emit-index-url --no-deps -o cross-requirements.txt",
   "group": null,
   "inputs": [
    "requirements.txt"
   ],
   "outputs": [
    "cross-requirements.txt"
   ]
  },
  {
   "__type__": "RunStep",
   "command": "uvx pip install -r cross-requirements.txt  --target opt/venv/lib/python3.13/site-packages --platform wasix_wasm32 --only-binary=:all: --python-version=3.13 --compile",
   "group": null,
   "inputs": null,
   "outputs": null
  },
  {
   "__type__": "RunStep",
   "command": "rm cross-requirements.txt",
   "group": null,
   "inputs": null,
   "outputs": null
  },
  {
   "__type__": "PathStep",
   "path": "opt/local_venv/bin"
  },
  {
   "__type__": "CopyStep",
   "base": "source",
   "ignore": [
    ".venv",
    ".git",
    "__pycache__"
   ],
   "source": ".",
   "target": "."
  }
 ],
 "commands": {
  "start": "streamlit run streamlit_app.py --server.port 8080 --server.address 0.0.0.0 --server.headless true"
 },
 "cwd": "app",
 "deps": [
  "python@3.13"
 ],
 "env": {
  "HOME": "app",
  "PYTHONPATH": "app:opt/venv/lib/python3.13/site-packages",
  "STREAMLIT_SERVER_HEADLESS": "true"
 },
 "mounts": [
  {
   "build_path": "app",
   "name": "app",
   "serve_path": "app"
  },
  {
   "build_path": "opt/venv",
   "name": "venv",
   "serve_path": "opt/venv"
  }
 ],
 "name": "python-streamlit",
 "prepare": [
  {
   "__type__": "RunStep",
   "command": "echo \"Precompiling Python code...\"",
   "group": null,
   "inputs": null,
   "outputs": null
  },
  {
   "__type__": "RunStep",
   "command": "python -m compileall -o 2 opt/venv/lib/python3.13/site-packages || true",
   "group": null,
   "inputs": null,
   "outputs": null
  },
  {
   "__type__": "RunStep",
   "command": "echo \"Precompiling package code...\"",
   "group": null,
   "inputs": null,
   "outputs": null
  },
  {
   "__type__": "RunStep",
   "command": "python -m compileall -o 2 app || true",
   "group": null,
   "inputs": null,
   "outputs": null
  }
 ],
 "provider": "python",
 "services": [],
 "volumes": []
}
