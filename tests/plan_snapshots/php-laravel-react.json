{
 "build": [
  {
   "__type__": "UseStep",
   "dependencies": [
    {
     "architecture": null,
     "name": "php",
     "version": "8.3.29"
    },
    {
     "architecture": null,
     "name": "composer",
     "version": null
    },
    {
     "architecture": null,
     "name": "node",
     "version": "24"
    },
    {
     "architecture": null,
     "name": "npm",
     "version": null
    }
   ]
  },
  {
   "__type__": "WorkdirStep",
   "path": "<SHIPIT_DIR>/local/build/app"
  },
  {
   "__type__": "CopyStep",
   "base": "assets",
   "ignore": null,
   "source": "php/php.ini",
   "target": "<SHIPIT_DIR>/local/build/opt/assets/php.ini"
  },
  {
   "__type__": "EnvStep",
   "variables": {
    "COMPOSER_ALLOW_SUPERUSER": "1",
    "COMPOSER_FUND": "0",
    "COMPOSER_HOME": "/tmp"
   }
  },
  {
   "__type__": "RunStep",
   "command": "composer install --optimize-autoloader --ignore-platform-reqs --no-scripts --no-interaction",
   "group": "install",
   "inputs": [
    "composer.json",
    "composer.lock"
   ],
   "outputs": [
    "."
   ]
  },
  {
   "__type__": "CopyStep",
   "base": "source",
   "ignore": null,
   "source": "package-lock.json",
   "target": "package-lock.json"
  },
  {
   "__type__": "EnvStep",
   "variables": {
    "CI": "true",
    "NPM_CONFIG_FUND": "false"
   }
  },
  {
   "__type__": "RunStep",
   "command": "npm install",
   "group": "install",
   "inputs": [
    "package.json"
   ],
   "outputs": null
  },
  {
   "__type__": "CopyStep",
   "base": "source",
   "ignore": [
    ".git",
    "node_modules",
    "vendor"
   ],
   "source": ".",
   "target": "."
  },
  {
   "__type__": "RunStep",
   "command": "composer run-script post-update-cmd",
   "group": "build",
   "inputs": null,
   "outputs": [
    "."
   ]
  },
  {
   "__type__": "RunStep",
   "command": "npm run build",
   "group": "build",
   "inputs": null,
   "outputs": null
  }
 ],
 "commands": {
  "after_deploy": "php artisan migrate",
  "start": "php -S localhost:8080 -t public"
 },
 "cwd": "<SHIPIT_DIR>/local/build/app",
 "deps": [
  "php@8.3.29",
  "bash"
 ],
 "env": {
  "PHP_INI_SCAN_DIR": "<SHIPIT_DIR>/local/build/opt/assets"
 },
 "mounts": [
  {
   "build_path": "<SHIPIT_DIR>/local/build/app",
   "name": "app",
   "serve_path": "<SHIPIT_DIR>/local/build/app"
  },
  {
   "build_path": "<SHIPIT_DIR>/local/build/opt/assets",
   "name": "assets",
   "serve_path": "<SHIPIT_DIR>/local/build/opt/assets"
  }
 ],
 "name": "php-laravel-react",
 "prepare": [
  {
   "__type__": "RunStep",
   "command": "mkdir -p storage/framework/{sessions,views,cache,testing} storage/logs bootstrap/cache",
   "group": null,
   "inputs": null,
   "outputs": null
  },
  {
   "__type__": "RunStep",
   "command": "php artisan config:cache",
   "group": null,
   "inputs": null,
   "outputs": null
  },
  {
   "__type__": "RunStep",
   "command": "php artisan event:cache",
   "group": null,
   "inputs": null,
   "outputs": null
  },
  {
   "__type__": "RunStep",
   "command": "php artisan route:cache",
   "group": null,
   "inputs": null,
   "outputs": null
  },
  {
   "__type__": "RunStep",
   "command": "php artisan view:cache",
   "group": null,
   "inputs": null,
   "outputs": null
  }
 ],
 "provider": "laravel",
 "services": [],
 "volumes": []
}
