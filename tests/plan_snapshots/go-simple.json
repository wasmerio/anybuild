{
 "build": [
  {
   "__type__": "WorkdirStep",
   "path": "opt/temp"
  },
  {
   "__type__": "UseStep",
   "dependencies": [
    {
     "architecture": null,
     "name": "go",
     "version": "1.25.5"
    }
   ]
  },
  {
   "__type__": "CopyStep",
   "base": "source",
   "ignore": [
    ".git"
   ],
   "source": ".",
   "target": "."
  },
  {
   "__type__": "EnvStep",
   "variables": {
    "GOCACHE": "/tmp/.cache/go-build",
    "GOPATH": "opt/temp"
   }
  },
  {
   "__type__": "RunStep",
   "command": "go build -o server server.go",
   "group": "build",
   "inputs": null,
   "outputs": null
  },
  {
   "__type__": "RunStep",
   "command": "cp opt/temp/server app/server",
   "group": null,
   "inputs": null,
   "outputs": null
  }
 ],
 "commands": {
  "start": "app/server"
 },
 "cwd": "app",
 "deps": [],
 "env": {},
 "mounts": [
  {
   "build_path": "app",
   "name": "app",
   "serve_path": "app"
  }
 ],
 "name": "go-simple",
 "prepare": [],
 "provider": "go",
 "services": [],
 "volumes": []
}
