{
 "build": [
  {
   "__type__": "UseStep",
   "dependencies": [
    {
     "architecture": null,
     "name": "node",
     "version": "24"
    },
    {
     "architecture": null,
     "name": "npm",
     "version": null
    }
   ]
  },
  {
   "__type__": "WorkdirStep",
   "path": "<SHIPIT_DIR>/local/build/opt/build"
  },
  {
   "__type__": "CopyStep",
   "base": "source",
   "ignore": null,
   "source": "package-lock.json",
   "target": "package-lock.json"
  },
  {
   "__type__": "EnvStep",
   "variables": {
    "CI": "true",
    "NPM_CONFIG_FUND": "false"
   }
  },
  {
   "__type__": "RunStep",
   "command": "npm install",
   "group": "install",
   "inputs": [
    "package.json"
   ],
   "outputs": null
  },
  {
   "__type__": "CopyStep",
   "base": "source",
   "ignore": [
    "node_modules",
    ".git",
    "package-lock.json"
   ],
   "source": ".",
   "target": "."
  },
  {
   "__type__": "RunStep",
   "command": "npx -y next-bundle@1.0.0 --build-command 'npm run build'",
   "group": "build",
   "inputs": null,
   "outputs": [
    "."
   ]
  },
  {
   "__type__": "RunStep",
   "command": "npm prune --omit=dev --ignore-scripts",
   "group": "prune",
   "inputs": null,
   "outputs": null
  },
  {
   "__type__": "RunStep",
   "command": "cp -R .next-bundle/* <SHIPIT_DIR>/local/build/app",
   "group": null,
   "inputs": null,
   "outputs": null
  }
 ],
 "commands": {
  "start": "node server.mjs"
 },
 "cwd": "<SHIPIT_DIR>/local/build/app",
 "deps": [
  "node@24"
 ],
 "env": {},
 "mounts": [
  {
   "build_path": "<SHIPIT_DIR>/local/build/app",
   "name": "app",
   "serve_path": "<SHIPIT_DIR>/local/build/app"
  }
 ],
 "name": "node-next",
 "prepare": [],
 "provider": "node",
 "services": [],
 "volumes": []
}
