{
 "build": [
  {
   "__type__": "UseStep",
   "dependencies": [
    {
     "architecture": null,
     "name": "ruby",
     "version": "3.4.7"
    }
   ]
  },
  {
   "__type__": "WorkdirStep",
   "path": "<SHIPIT_DIR>/local/build/opt/temp"
  },
  {
   "__type__": "CopyStep",
   "base": "source",
   "ignore": null,
   "source": "Gemfile.lock",
   "target": "Gemfile.lock"
  },
  {
   "__type__": "RunStep",
   "command": "bundle install",
   "group": "install",
   "inputs": [
    "Gemfile"
   ],
   "outputs": null
  },
  {
   "__type__": "CopyStep",
   "base": "source",
   "ignore": [
    ".git"
   ],
   "source": ".",
   "target": "."
  },
  {
   "__type__": "RunStep",
   "command": "jekyll build",
   "group": "build",
   "inputs": null,
   "outputs": null
  },
  {
   "__type__": "RunStep",
   "command": "cp -R _site/* <SHIPIT_DIR>/local/build/opt/static_app/",
   "group": null,
   "inputs": null,
   "outputs": null
  }
 ],
 "commands": {
  "start": "static-web-server --root=<SHIPIT_DIR>/local/build/opt/static_app --log-level=info --port=8080"
 },
 "ctx_mounts": [
  {
   "build_path": "<SHIPIT_DIR>/local/build/opt/temp",
   "name": "temp",
   "serve_path": "<SHIPIT_DIR>/local/build/opt/temp"
  },
  {
   "build_path": "<SHIPIT_DIR>/local/build/opt/static_app",
   "name": "static_app",
   "serve_path": "<SHIPIT_DIR>/local/build/opt/static_app"
  }
 ],
 "ctx_packages": {
  "ruby@3.4.7": "ruby@3.4.7",
  "static-web-server@2.38.0": "static-web-server@2.38.0"
 },
 "ctx_services": {},
 "ctx_volumes": [],
 "cwd": null,
 "deps": [
  "static-web-server@2.38.0"
 ],
 "env": {},
 "mounts": [
  {
   "build_path": "<SHIPIT_DIR>/local/build/opt/static_app",
   "name": "static_app",
   "serve_path": "<SHIPIT_DIR>/local/build/opt/static_app"
  }
 ],
 "name": "workspace",
 "prepare": [],
 "provider": "jekyll",
 "services": [],
 "volumes": []
}
