{
 "build": [
  {
   "__type__": "UseStep",
   "dependencies": [
    {
     "architecture": null,
     "name": "php",
     "version": "8.3.29"
    }
   ]
  },
  {
   "__type__": "CopyStep",
   "base": "source",
   "ignore": null,
   "source": "https://raw.githubusercontent.com/wp-cli/builds/gh-pages/phar/wp-cli.phar",
   "target": "<SHIPIT_DIR>/local/build/opt/assets/wp-cli.phar"
  },
  {
   "__type__": "CopyStep",
   "base": "assets",
   "ignore": null,
   "source": "wordpress/install.sh",
   "target": "<SHIPIT_DIR>/local/build/opt/assets/setup-wp.sh"
  },
  {
   "__type__": "CopyStep",
   "base": "assets",
   "ignore": null,
   "source": "wordpress/wp-config.php",
   "target": "<SHIPIT_DIR>/local/build/app/wp-config.php"
  },
  {
   "__type__": "CopyStep",
   "base": "assets",
   "ignore": null,
   "source": "wordpress/.htaccess",
   "target": "<SHIPIT_DIR>/local/build/app/.htaccess"
  },
  {
   "__type__": "WorkdirStep",
   "path": "<SHIPIT_DIR>/local/build/app"
  },
  {
   "__type__": "CopyStep",
   "base": "assets",
   "ignore": null,
   "source": "php/php.ini",
   "target": "<SHIPIT_DIR>/local/build/opt/assets/php.ini"
  },
  {
   "__type__": "CopyStep",
   "base": "source",
   "ignore": [
    ".git",
    "wp-content"
   ],
   "source": ".",
   "target": "."
  },
  {
   "__type__": "CopyStep",
   "base": "source",
   "ignore": null,
   "source": "wp-content",
   "target": "<SHIPIT_DIR>/local/build/opt/wpcontent_base"
  }
 ],
 "commands": {
  "after_deploy": "bash <SHIPIT_DIR>/local/build/opt/assets/setup-wp.sh",
  "start": "php -S localhost:8080 -t <SHIPIT_DIR>/local/build/app",
  "wp": "php <SHIPIT_DIR>/local/build/opt/assets/wp-cli.phar --allow-root --path=<SHIPIT_DIR>/local/build/app"
 },
 "ctx_mounts": [
  {
   "build_path": "<SHIPIT_DIR>/local/build/app",
   "name": "app",
   "serve_path": "<SHIPIT_DIR>/local/build/app"
  },
  {
   "build_path": "<SHIPIT_DIR>/local/build/opt/assets",
   "name": "assets",
   "serve_path": "<SHIPIT_DIR>/local/build/opt/assets"
  },
  {
   "build_path": "<SHIPIT_DIR>/local/build/opt/wpcontent_base",
   "name": "wpcontent_base",
   "serve_path": "<SHIPIT_DIR>/local/build/opt/wpcontent_base"
  }
 ],
 "ctx_packages": {
  "bash": "bash",
  "php@8.3.29": "php@8.3.29"
 },
 "ctx_services": {
  "database": {
   "name": "database",
   "provider": "mysql"
  }
 },
 "ctx_volumes": [
  {
   "name": "wp-content",
   "path": "<SHIPIT_DIR>/volumes/wp-content",
   "serve_path": "<SHIPIT_DIR>/local/build/app/wp-content"
  }
 ],
 "cwd": "<SHIPIT_DIR>/local/build/app",
 "deps": [
  "php@8.3.29",
  "bash"
 ],
 "env": {
  "PAGER": "cat",
  "PHP_INI_SCAN_DIR": "<SHIPIT_DIR>/local/build/opt/assets",
  "WPCONTENT_BASE_PATH": "<SHIPIT_DIR>/local/build/opt/wpcontent_base"
 },
 "mounts": [
  {
   "build_path": "<SHIPIT_DIR>/local/build/app",
   "name": "app",
   "serve_path": "<SHIPIT_DIR>/local/build/app"
  },
  {
   "build_path": "<SHIPIT_DIR>/local/build/opt/assets",
   "name": "assets",
   "serve_path": "<SHIPIT_DIR>/local/build/opt/assets"
  },
  {
   "build_path": "<SHIPIT_DIR>/local/build/opt/wpcontent_base",
   "name": "wpcontent_base",
   "serve_path": "<SHIPIT_DIR>/local/build/opt/wpcontent_base"
  }
 ],
 "name": "php-wordpress",
 "prepare": [],
 "provider": "wordpress",
 "services": [
  {
   "name": "database",
   "provider": "mysql"
  }
 ],
 "volumes": [
  {
   "name": "wp-content",
   "path": "<SHIPIT_DIR>/volumes/wp-content",
   "serve_path": "<SHIPIT_DIR>/local/build/app/wp-content"
  }
 ]
}
