{
 "build": [
  {
   "__type__": "UseStep",
   "dependencies": [
    {
     "architecture": null,
     "name": "python",
     "version": "3.13"
    },
    {
     "architecture": null,
     "name": "uv",
     "version": "0.8.15"
    }
   ]
  },
  {
   "__type__": "WorkdirStep",
   "path": "<SHIPIT_DIR>/local/build/opt/temp"
  },
  {
   "__type__": "EnvStep",
   "variables": {
    "UV_PROJECT_ENVIRONMENT": "<SHIPIT_DIR>/local/build/opt/local_venv"
   }
  },
  {
   "__type__": "RunStep",
   "command": "uv init",
   "group": "install",
   "inputs": [],
   "outputs": [
    "uv.lock"
   ]
  },
  {
   "__type__": "RunStep",
   "command": "uv add -r requirements.txt ",
   "group": "install",
   "inputs": [
    "requirements.txt"
   ],
   "outputs": null
  },
  {
   "__type__": "PathStep",
   "path": "<SHIPIT_DIR>/local/build/opt/local_venv/bin"
  },
  {
   "__type__": "CopyStep",
   "base": "source",
   "ignore": [
    ".venv",
    ".git",
    "__pycache__"
   ],
   "source": ".",
   "target": "."
  },
  {
   "__type__": "RunStep",
   "command": "uv run mkdocs build --site-dir=<SHIPIT_DIR>/local/build/opt/static_app",
   "group": "build",
   "inputs": null,
   "outputs": [
    "."
   ]
  }
 ],
 "commands": {
  "start": "static-web-server --root=<SHIPIT_DIR>/local/build/opt/static_app --log-level=info --port=8080"
 },
 "cwd": null,
 "deps": [
  "python@3.13",
  "static-web-server@2.38.0"
 ],
 "env": {},
 "mounts": [
  {
   "build_path": "<SHIPIT_DIR>/local/build/opt/static_app",
   "name": "static_app",
   "serve_path": "<SHIPIT_DIR>/local/build/opt/static_app"
  }
 ],
 "name": "mkdocs-with-plugins",
 "prepare": [],
 "provider": "mkdocs",
 "services": [],
 "volumes": []
}
