{
 "build": [
  {
   "__type__": "UseStep",
   "dependencies": [
    {
     "architecture": null,
     "name": "python",
     "version": "3.13"
    },
    {
     "architecture": null,
     "name": "uv",
     "version": "0.8.15"
    }
   ]
  },
  {
   "__type__": "WorkdirStep",
   "path": "<SHIPIT_DIR>/local/build/app"
  },
  {
   "__type__": "EnvStep",
   "variables": {
    "UV_PROJECT_ENVIRONMENT": "<SHIPIT_DIR>/local/build/opt/local_venv"
   }
  },
  {
   "__type__": "RunStep",
   "command": "uv init",
   "group": "install",
   "inputs": [],
   "outputs": [
    "uv.lock"
   ]
  },
  {
   "__type__": "RunStep",
   "command": "uv add -r requirements.txt mcp[cli]",
   "group": "install",
   "inputs": [
    "requirements.txt"
   ],
   "outputs": null
  },
  {
   "__type__": "RunStep",
   "command": "uv pip compile requirements.txt --python-version=3.13 --universal --extra-index-url None --index-url=https://pypi.org/simple --emit-index-url --no-deps -o cross-requirements.txt",
   "group": null,
   "inputs": [
    "requirements.txt"
   ],
   "outputs": [
    "cross-requirements.txt"
   ]
  },
  {
   "__type__": "RunStep",
   "command": "uvx pip install -r cross-requirements.txt mcp[cli] --target <SHIPIT_DIR>/local/build/opt/venv/lib/python3.13/site-packages --platform wasix_wasm32 --only-binary=:all: --python-version=3.13 --compile",
   "group": null,
   "inputs": null,
   "outputs": null
  },
  {
   "__type__": "RunStep",
   "command": "rm cross-requirements.txt",
   "group": null,
   "inputs": null,
   "outputs": null
  },
  {
   "__type__": "PathStep",
   "path": "<SHIPIT_DIR>/local/build/opt/local_venv/bin"
  },
  {
   "__type__": "CopyStep",
   "base": "source",
   "ignore": [
    ".venv",
    ".git",
    "__pycache__"
   ],
   "source": ".",
   "target": "."
  },
  {
   "__type__": "RunStep",
   "command": "mkdir -p <SHIPIT_DIR>/local/build/opt/venv/bin",
   "group": null,
   "inputs": null,
   "outputs": null
  },
  {
   "__type__": "RunStep",
   "command": "cp <SHIPIT_DIR>/local/build/opt/local_venv/bin/mcp <SHIPIT_DIR>/local/build/opt/venv/bin/mcp",
   "group": null,
   "inputs": null,
   "outputs": null
  }
 ],
 "commands": {
  "start": "python main.py"
 },
 "cwd": "<SHIPIT_DIR>/local/build/app",
 "deps": [
  "python@3.13"
 ],
 "env": {
  "FASTMCP_HOST": "0.0.0.0",
  "FASTMCP_PORT": "8080",
  "HOME": "<SHIPIT_DIR>/local/build/app",
  "PYTHONPATH": "<SHIPIT_DIR>/local/build/app:<SHIPIT_DIR>/local/build/opt/venv/lib/python3.13/site-packages"
 },
 "mounts": [
  {
   "build_path": "<SHIPIT_DIR>/local/build/app",
   "name": "app",
   "serve_path": "<SHIPIT_DIR>/local/build/app"
  },
  {
   "build_path": "<SHIPIT_DIR>/local/build/opt/venv",
   "name": "venv",
   "serve_path": "<SHIPIT_DIR>/local/build/opt/venv"
  }
 ],
 "name": "python-mcp-chatgpt",
 "prepare": [
  {
   "__type__": "RunStep",
   "command": "echo \"Precompiling Python code...\"",
   "group": null,
   "inputs": null,
   "outputs": null
  },
  {
   "__type__": "RunStep",
   "command": "python -m compileall -o 2 <SHIPIT_DIR>/local/build/opt/venv/lib/python3.13/site-packages || true",
   "group": null,
   "inputs": null,
   "outputs": null
  },
  {
   "__type__": "RunStep",
   "command": "echo \"Precompiling package code...\"",
   "group": null,
   "inputs": null,
   "outputs": null
  },
  {
   "__type__": "RunStep",
   "command": "python -m compileall -o 2 <SHIPIT_DIR>/local/build/app || true",
   "group": null,
   "inputs": null,
   "outputs": null
  }
 ],
 "provider": "python",
 "services": [],
 "volumes": []
}
