node_version = getenv("SHIPIT_NODE_VERSION") or "22"

node = dep(
    "node",
    node_version,
)

npm_version = getenv("SHIPIT_NPM_VERSION")

npm = dep(
    "npm",
    npm_version,
)

staticwebserver_version = getenv("SHIPIT_SWS_VERSION") or "2.38.0"

staticwebserver = dep(
    "static-web-server",
    staticwebserver_version,
)

temp = mount("temp")

app = mount("app")

PORT = getenv("PORT") or "8080"

shipit_static_dir = getenv("SHIPIT_STATIC_DIR") or "dist"

serve(
    name = "nuxt",
    provider = "node-static",
    cwd = app["serve"],
    build = [
        use(
            node,
            npm,
        ),
        workdir(temp["build"]),
        copy("package-lock.json"),
        run("npm ci", inputs=["package.json"], group="install"),
        copy(
            ".",
            ignore = [
                "node_modules",
                ".git",
                "package-lock.json",
            ],
        ),
        run("npm run build", outputs=[shipit_static_dir], group="build"),
        run("cp -R {}/* {}/".format(shipit_static_dir, app["build"])),
    ],
    deps = [staticwebserver],
    commands = {
        "start": "static-web-server --root={} --log-level=info --port={}".format(app["serve"], PORT).replace("$PORT", PORT),
    },
    mounts = [app],
)
