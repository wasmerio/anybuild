node_version = getenv("AUTOBUILD_NODE_VERSION") or "22"  # from .node-version
node = dep("node", node_version)

staticwebserver = dep("static-web-server")

serve(
  name="staticsite-gatsby",
  provider="staticsite",
  build=[
    use(node, dep("npm")),
    run("npm install", inputs=["package.json", "package-lock.json"], group="install"),
    copy(".", ".", ignore=["node_modules", ".git"]),
    run("npm run generate", outputs=[".output/public"], group="build"),
  ],
  deps=[staticwebserver],
  commands = {
    "start": "webserver --root /app/.output/public",
  },
)
