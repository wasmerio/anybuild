node = dep("node", config.node_version)
npm = dep("npm", config.npm_version)
staticwebserver = dep("static-web-server", config.sws_version)

temp = mount("temp")
static_app = mount("static_app")

serve(
  name="hexo",
  provider="node-static",
  build=[
    use(node, npm),
    workdir(temp.path),
    copy("package-lock.json"),
    env(CI="true", NODE_ENV="production", NPM_CONFIG_FUND="false"),
    run("npm ci", inputs=["package.json"], group="install"),
    copy(".", ignore=["node_modules", ".git", "package-lock.json"]),
    run("npm run generate", outputs=[config.static_dir], group="build"),
    run("cp -R {}/* {}/".format(config.static_dir, static_app.path))
  ],
  deps=[staticwebserver],
  commands = {
    "start": "static-web-server --root={} --log-level=info --port={}".format(static_app.serve_path, PORT)
  },
  mounts=[
    static_app
  ],
)
