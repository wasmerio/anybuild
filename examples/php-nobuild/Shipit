php_version = getenv("SHIPIT_PHP_VERSION") or "8.3"
php = dep("php", php_version)

HOME = getenv("HOME")

serve(
  name="php-nobuild",
  provider="php",
  build=[
    use(php),
    copy(".", ".", ignore=[".git"])
  ],
  assets={
    "php.ini": get_asset("php/php.ini")
  },
  deps=[php],
  commands = {
    "start": "php -S localhost:8080" -t .
  },
)
