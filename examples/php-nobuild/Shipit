phpix = dep("phpix", config.php_version, architecture=config.php_architecture)

app = mount("app")
assets = mount("assets")

serve(
  name="php-nobuild",
  provider="php",
  cwd=app.serve_path,
  build=[
    use(phpix),
    workdir(app.path),
    copy("php/php.ini", "{}/php.ini".format(assets.path), base="assets"),
    copy(".", ignore=[".git"])
  ],
  deps=[phpix],
  env = {
    "PHP_INI_SCAN_DIR": "{}".format(assets.serve_path),
    "PHPIX_PHP_THREADS": "4"
  },
  commands = {
    "start": "phpix -S localhost:{} -t {}".format(PORT, app.serve_path)
  },
  mounts=[
    app,
    assets
  ],
)
