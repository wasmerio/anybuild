php_version = getenv("SHIPIT_PHP_VERSION") or "8.3"
php = dep("php", php_version)

app = mount("app")
HOME = getenv("HOME")

serve(
  name="php-nobuild",
  provider="php",
  build=[
    use(php),
    workdir(app["build"]),
    copy(".", ".", ignore=[".git"])
  ],
  deps=[php],
  commands = {
    "start": "php -S localhost:8080" -t .
  },
  mounts=[
    app
  ],
)
