php = dep("php", metadata.php_version, architecture=metadata.php_architecture)

app = mount("app")
assets = mount("assets")

serve(
  name="php-nobuild",
  provider="php",
  cwd=app["serve"],
  build=[
    use(php),
    workdir(app["build"]),
    copy("php/php.ini", "{}/php.ini".format(assets["build"]), base="assets"),
    copy(".", ".", ignore=[".git"])
  ],
  deps=[php],
  env = {
    "PHP_INI_SCAN_DIR": "{}".format(assets["serve"])
  },
  commands = {
    "start": "php -S localhost:{} -t {}".format(PORT, app["serve"]).replace("$PORT", PORT)
  },
  mounts=[
    app,
    assets
  ],
)
