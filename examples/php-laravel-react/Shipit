phpix = dep("phpix", config.php_version, architecture=config.php_architecture)
composer = dep("composer")
bash = dep("bash")
node = dep("node", config.node_version)
npm = dep("npm", config.npm_version)

app = mount("app")
assets = mount("assets")

serve(
  name="php-laravel-react",
  provider="laravel",
  cwd=app.serve_path,
  build=[
    use(phpix, composer, node, npm),
    workdir(app.path),
    copy("php/php.ini", "{}/php.ini".format(assets.path), base="assets"),
    env(COMPOSER_HOME="/tmp", COMPOSER_FUND="0", COMPOSER_ALLOW_SUPERUSER="1"),
    run("composer install --optimize-autoloader --ignore-platform-reqs --no-scripts --no-interaction", inputs=["composer.json", "composer.lock"], outputs=["."], group="install"),
    copy("package-lock.json"),
    env(CI="true", NODE_ENV="production", NPM_CONFIG_FUND="false"),
    run("npm ci", inputs=["package.json"], group="install"),
    copy(".", ignore=[".git", "node_modules", "vendor"]),
    run("composer run-script post-update-cmd", outputs=["."], group="build"),
    run("npm run build", group="build")
  ],
  deps=[phpix, bash],
  prepare=[
    workdir(app.serve_path),
    run("mkdir -p storage/framework/{sessions,views,cache,testing} storage/logs bootstrap/cache"),
    run("php artisan config:cache"),
    run("php artisan event:cache"),
    run("php artisan route:cache"),
    run("php artisan view:cache")
  ],
  env = {
    "PHP_INI_SCAN_DIR": "{}".format(assets.serve_path),
    "PHPIX_PHP_THREADS": "4"
  },
  commands = {
    "start": f"php -S localhost:{PORT} -t public",
    "after_deploy": "php artisan migrate"
  },
  mounts=[
    app,
    assets
  ],
)
