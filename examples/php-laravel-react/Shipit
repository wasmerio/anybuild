php_version = getenv("SHIPIT_PHP_VERSION") or "8.3"

php = dep(
    "php",
    php_version,
)

composer = dep("composer")

pie = dep("pie")

pnpm = dep("pnpm")

bash = dep("bash")

app = mount("app")

database = service(
    name = "database",
    provider = "mysql",
)

PORT = getenv("PORT") or "8080"

HOME = getenv("HOME")

serve(
    name = "php-laravel-react",
    provider = "laravel",
    cwd = app["serve"],
    build = [
        use(
            php,
            composer,
            pie,
            pnpm,
        ),
        env(HOME=HOME, COMPOSER_FUND="0"),
        workdir(app["build"]),
        run("pie install php/pdo_pgsql"),
        run("composer install --optimize-autoloader --no-scripts --no-interaction", inputs=["composer.json", "composer.lock", "artisan"], outputs=["."], group="install"),
        run("pnpm install", inputs=["package.json", "package-lock.json"], outputs=["."], group="install"),
        copy(
            ".",
            target = ".",
            ignore = [".git"],
        ),
        run("pnpm run build", outputs=["."], group="build"),
    ],
    deps = [
        php,
        bash,
    ],
    prepare = [
        workdir(app["serve"]),
        run("mkdir -p storage/framework/{sessions,views,cache,testing} storage/logs bootstrap/cache"),
        run("php artisan config:cache"),
        run("php artisan event:cache"),
        run("php artisan route:cache"),
        run("php artisan view:cache"),
    ],
    commands = {
        "after_deploy": "php artisan migrate".replace("$PORT", PORT),
        "start": f"php -S localhost:{PORT} -t public".replace("$PORT", PORT),
    },
    mounts = [app],
    services = [database],
)
