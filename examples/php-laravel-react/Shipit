php = dep("php", metadata.php_version)
composer = dep("composer")
node = dep("node", metadata.node_version)
npm = dep("npm", metadata.npm_version)
staticwebserver = dep("static-web-server", metadata.sws_version)
bash = dep("bash")

app = mount("app")

serve(
  name="php-laravel-react",
  provider="laravel",
  cwd=app["serve"],
  build=[
    use(php, composer, node, npm),
    env(COMPOSER_HOME="/tmp", COMPOSER_FUND="0"),
    workdir(app["build"]),
    run("composer install --optimize-autoloader --no-scripts --no-interaction", inputs=["composer.json", "composer.lock", "artisan"], outputs=["."], group="install"),
    copy("package-lock.json"),
    env(CI="true", NODE_ENV="production", NPM_CONFIG_FUND="false"),
    run("npm ci", inputs=["package.json"], group="install"),
    copy(".", ignore=["node_modules", ".git", "package-lock.json"]),
    run("npm run build", group="build")
  ],
  deps=[php, staticwebserver, bash],
  prepare=[
    workdir(app["serve"]),
    run("mkdir -p storage/framework/{sessions,views,cache,testing} storage/logs bootstrap/cache"),
    run("php artisan config:cache"),
    run("php artisan event:cache"),
    run("php artisan route:cache"),
    run("php artisan view:cache")
  ],
  commands = {
    "start": (metadata.commands.start or f"php -S localhost:{PORT} -t public").replace("$PORT", PORT),
    "after_deploy": "php artisan migrate".replace("$PORT", PORT)
  },
  mounts=[
    app
  ],
)
