staticwebserver = dep("static-web-server", metadata.sws_version)

static_app = mount("static_app")

serve(
  name="staticfile",
  provider="staticfile",
  build=[
    workdir(static_app["build"]),
    copy("site", ".", ignore=[".git"])
  ],
  deps=[staticwebserver],
  commands = {
    "start": "static-web-server --root={} --log-level=info --port={}".format(static_app["serve"], PORT)
  },
  mounts=[
    static_app
  ],
)
