node = dep("node", config.node_version)
npm = dep("npm", config.npm_version)

app = mount("app")

serve(
  name="node",
  provider="node",
  cwd=app.serve_path,
  build=[
    use(node, npm),
    workdir(app.path),
    copy("package-lock.json"),
    env(CI="true", NPM_CONFIG_FUND="false"),
    run("npm install", inputs=["package.json"], group="install"),
    copy(".", ignore=["node_modules", ".git", "package-lock.json"]),
    run("npm prune --omit=dev --ignore-scripts", group="prune")
  ],
  deps=[node],
  env = {
    "PORT": PORT
  },
  commands = {
    "start": "node server.js"
  },
  mounts=[
    app
  ],
)
