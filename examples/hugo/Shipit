hugo = dep("hugo", metadata.hugo_version)
staticwebserver = dep("static-web-server", metadata.sws_version)

temp = mount("temp")
static_app = mount("static_app")

serve(
  name="hugo",
  provider="hugo",
  build=[
    use(hugo),
    workdir(temp["build"]),
    copy(".", ".", ignore=[".git"]),
    run("hugo build --destination={}".format(static_app["build"]), group="build")
  ],
  deps=[staticwebserver],
  commands = {
    "start": (metadata.commands.start or "static-web-server --root={} --log-level=info --port={}".format(static_app["serve"], PORT)).replace("$PORT", PORT)
  },
  mounts=[
    static_app
  ],
)
