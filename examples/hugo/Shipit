hugo_version = getenv("SHIPIT_HUGO_VERSION") or "0.149.0"  # from .node-version
sws_version = getenv("SHIPIT_SWS_VERSION") or "2.38.0"

hugo = dep("hugo", hugo_version)
staticwebserver = dep("static-web-server", sws_version)

serve(
  name="staticsite-hugo",
  provider="staticsite",
  build=[
    use(hugo),
    copy(".", ".", ignore=[".git"]),
    run("hugo build", outputs=["public"], group="build"),
  ],
  deps=[staticwebserver],
  commands = {
    "start": "static-web-server --root {}".format(buildpath("public")),
  },
)
