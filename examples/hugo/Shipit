hugo = dep("hugo", metadata.hugo_version)
staticwebserver = dep("static-web-server", metadata.sws_version)

temp = mount("temp")
static_app = mount("static_app")

serve(
  name="hugo",
  provider="hugo",
  build=[
    use(hugo),
    workdir(temp.path),
    copy(".", ".", ignore=[".git"]),
    run("hugo build --destination={}".format(static_app.path), group="build")
  ],
  deps=[staticwebserver],
  commands = {
    "start": "static-web-server --root={} --log-level=info --port={}".format(static_app.serve_path, PORT)
  },
  mounts=[
    static_app
  ],
)
