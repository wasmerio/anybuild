hugo_version = getenv("SHIPIT_HUGO_VERSION") or "0.149.0"
hugo = dep("hugo", hugo_version)
staticwebserver_version = getenv("SHIPIT_SWS_VERSION") or "2.38.0"
staticwebserver = dep("static-web-server", staticwebserver_version)

temp = mount("temp")

app = mount("app")

PORT = getenv("PORT") or "8080"

serve(
    name = "hugo",
    provider = "hugo",
    cwd = app["serve"],
    build = [
        use(hugo),
        workdir(temp["build"]),
        copy(".", ".", ignore = [".git"]),
        run("hugo build --destination={}".format(app["build"]), group = "build"),
    ],
    deps = [staticwebserver],
    commands = {
        "start": "static-web-server --root={} --log-level=info --port={}".format(app["serve"], PORT).replace("$PORT", PORT),
    },
    mounts = [
        app,
    ],
)
