node_version = getenv("SHIPIT_NODE_VERSION") or "22"
node = dep("node", node_version)
npm = dep("npm")
staticwebserver_version = getenv("SHIPIT_SWS_VERSION")
staticwebserver = dep("static-web-server", staticwebserver_version)

app = mount("app")

PORT = getenv("PORT") or 8080

serve(
  name="gatsby",
  provider="staticsite",
  cwd=app["serve"],
  build=[
    use(node, npm),
    run("npm install", inputs=["package.json", "package-lock.json"], group="install"),
    copy(".", ".", ignore=["node_modules", ".git"]),
    run("npm run build", outputs=["public"], group="build"),
    run("cp -R public/* {}/".format(app["build"]))
  ],
  deps=[staticwebserver],
  commands = {
    "start": "static-web-server --root /app".replace("$PORT", PORT)
  },
  mounts=[
    app
  ],
)
