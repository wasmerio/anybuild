
 # from .python-version
python_version = getenv("AUTOBUILD_PYTHON_VERSION") or "3.13"

python = dep("python", python_version)

cross_platform = getenv("AUTOBUILD_PYTHON_CROSS_PLATFORM")
python_extra_index_url = getenv("AUTOBUILD_PYTHON_EXTRA_INDEX_URL")
python_cross_packages_serve_path = None

if cross_platform:
  python_cross_packages_path = serve_mount("python-cross-packages")
  if cross_platform == "wasix_wasm32":
    python_cross_packages_serve_path = f"/cpython/lib/python{python_version}/site-packages"

serve(
  name="python-fastapi",
  provider="python",
  build=[
    use(python, dep("uv")),
    run("uv sync --compile --no-managed-python", inputs=["pyproject.toml", "uv.lock", ".python-version"], outputs=["."], group="install"),
    run(f"uv pip compile pyproject.toml --python-version={python_version} --universal --extra-index-url {python_extra_index_url} --index-url=https://pypi.org/simple --emit-index-url --only-binary :all: -o cross-requirements.txt") if cross_platform else None,
    run(f"uvx pip install -r cross-requirements.txt --target {python_cross_packages_path} --platform {cross_platform} --only-binary=:all: --python-version={python_version} --compile") if cross_platform else None,
    path(".venv/bin"),
    copy(".", ".", ignore=[".venv", ".git", "__pycache__"]),
    run(f"python manage.py collectstatic --noinput", outputs=["."], group="django:collectstatic"),
    run("rm -rf .venv") if cross_platform else None,
  ],
  deps=[python],
  commands = {
    "start": "python manage.py runserver 0.0.0.0:8000",
    "after_deploy": f"python manage.py migrate",
    "hello": "python -c 'print(\"Hello, World!\")'",
  },
  # workers = [
  #   "python -m celery ...",
  # ],
  mounts={
    python_cross_packages_serve_path: python_cross_packages_path
  },
) # -> (package.webc, app.yaml) (then it can run locally, deploy, ...)
