staticwebserver = dep("static-web-server", config.sws_version)

static_app = mount("static_app")
static_config = mount("static_config")

serve(
  name="staticfile-redirects",
  provider="staticfile",
  build=[
    workdir(static_app.path),
    copy("site", ".", ignore=[".git"]),
    write("{}/sws.toml".format(static_config.path), "[[advanced.redirects]]\nsource = \"/docs/{**}\"\ndestination = \"/guides/$1/\"\nkind = 301\n")
  ],
  deps=[staticwebserver],
  commands = {
    "start": "static-web-server --root={} --log-level=info --config-file={}/sws.toml --port={}".format(static_app.serve_path, static_config.serve_path, PORT)
  },
  mounts=[
    static_app,
    static_config
  ],
)
