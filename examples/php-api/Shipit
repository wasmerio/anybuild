php_version = getenv("SHIPIT_PHP_VERSION") or "8.3"
php_architecture = getenv("SHIPIT_PHP_ARCHITECTURE")
php = dep("php", php_version, architecture = php_architecture)
composer = dep("composer")
bash = dep("bash")

app = mount("app")

assets = mount("assets")

PORT = getenv("PORT") or "8080"
HOME = getenv("HOME")

serve(
    name = "php-api",
    provider = "php",
    cwd = app["serve"],
    build = [
        use(php, composer),
        workdir(app["build"]),
        copy("php/php.ini", "{}/php.ini".format(assets["build"]), base = "assets"),
        env(HOME = HOME, COMPOSER_FUND = "0"),
        run("composer install --optimize-autoloader --no-scripts --no-interaction", inputs = ["composer.json", "composer.lock"], outputs = ["."], group = "install"),
        copy(".", ".", ignore = [".git"]),
    ],
    deps = [php, bash],
    env = {
        "PHP_INI_SCAN_DIR": "{}".format(assets["serve"]),
    },
    commands = {
        "start": "php -S localhost:{} -t {}/public".format(PORT, app["serve"]).replace("$PORT", PORT),
    },
    mounts = [
        app,
        assets,
    ],
)
