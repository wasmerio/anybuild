php = dep("php", metadata.php_version, architecture=metadata.php_architecture)
composer = dep("composer")
bash = dep("bash")

app = mount("app")
assets = mount("assets")

serve(
  name="php-api",
  provider="php",
  cwd=app.serve_path,
  build=[
    use(php, composer),
    workdir(app.path),
    copy("php/php.ini", "{}/php.ini".format(assets.path), base="assets"),
    env(COMPOSER_HOME="/tmp", COMPOSER_FUND="0"),
    run("composer install --optimize-autoloader --no-scripts --no-interaction", inputs=["composer.json", "composer.lock"], outputs=["."], group="install"),
    copy(".", ".", ignore=[".git"])
  ],
  deps=[php, bash],
  env = {
    "PHP_INI_SCAN_DIR": "{}".format(assets.serve_path)
  },
  commands = {
    "start": "php -S localhost:{} -t {}/public".format(PORT, app.serve_path)
  },
  mounts=[
    app,
    assets
  ],
)
