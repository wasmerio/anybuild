phpix = dep("phpix", config.php_version, architecture=config.php_architecture)
composer = dep("composer")
bash = dep("bash")

app = mount("app")
assets = mount("assets")

serve(
  name="php-api",
  provider="php",
  cwd=app.serve_path,
  build=[
    use(phpix, composer),
    workdir(app.path),
    copy("php/php.ini", "{}/php.ini".format(assets.path), base="assets"),
    env(COMPOSER_HOME="/tmp", COMPOSER_FUND="0", COMPOSER_ALLOW_SUPERUSER="1"),
    run("composer install --optimize-autoloader --ignore-platform-reqs --no-scripts --no-interaction", inputs=["composer.json", "composer.lock"], outputs=["."], group="install"),
    copy(".", ignore=[".git", "vendor"])
  ],
  deps=[phpix, bash],
  env = {
    "PHP_INI_SCAN_DIR": "{}".format(assets.serve_path),
    "PHPIX_PHP_THREADS": "4"
  },
  commands = {
    "start": "phpix -S localhost:{} -t {}/public".format(PORT, app.serve_path)
  },
  mounts=[
    app,
    assets
  ],
)
