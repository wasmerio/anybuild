php_version = getenv("SHIPIT_PHP_VERSION") or "8.3"

php_architecture = getenv("SHIPIT_PHP_ARCHITECTURE")

php = dep(
    "php",
    php_version,
    architecture = php_architecture,
)

bash = dep("bash")

app = mount("app")

assets = mount("assets")

wp_content = volume(
    "wp-content",
    "{}/wp-content/".format(app["serve"]),
)

database = service(
    name = "database",
    provider = "mysql",
)

PORT = getenv("PORT") or "8080"

wp_cli_version = getenv("SHIPIT_WPCLI_VERSION")
if wp_cli_version:
wp_cli_download_url = f"https://github.com/wp-cli/wp-cli/releases/download/v{wp_cli_version}/wp-cli-{wp_cli_version}.phar"
else:
wp_cli_download_url = "https://raw.githubusercontent.com/wp-cli/builds/gh-pages/phar/wp-cli.phar"


serve(
    name = "php-wordpress",
    provider = "wordpress",
    cwd = app["serve"],
    build = [
        use(php),
        copy(
            "wp_cli_download_url",
            target = "\"{}/wp-cli.phar\".format(assets[\"build\"]",
        ),
        copy(
            "wordpress/install.sh",
            target = "\"{}/setup-wp.sh\".format(assets[\"build\"])",
        ),
        copy(
            "wordpress/wp-config.php",
            target = "\"{}/wp-config.php\".format(app[\"build\"])",
        ),
        workdir(app["build"]),
        copy(
            "php/php.ini",
            target = "\"{}/php.ini\".format(assets[\"build\"])",
        ),
        copy(
            ".",
            target = ".",
            ignore = [".git"],
        ),
    ],
    deps = [
        php,
        bash,
    ],
    env = {
        "PAGER": "cat",
        "PHP_INI_SCAN_DIR": "{}".format(assets["serve"]),
    },
    commands = {
        "after_deploy": "bash {}/setup-wp.sh".format(assets["serve"]).replace("$PORT", PORT),
        "start": "php -S localhost:{} -t {}".format(PORT, app["serve"]).replace("$PORT", PORT),
    },
    mounts = [
        app,
        assets,
    ],
    volumes = [wp_content],
    services = [database],
)
