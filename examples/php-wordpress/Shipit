php_version = getenv("SHIPIT_PHP_VERSION") or "8.3"
php = dep("php", php_version)
bash = dep("bash")

app = mount("app")

assets = mount("assets")

wp_content = volume("wp-content", "{}/wp-content/".format(app["serve"]))

database = service(
  name="database",
  provider="mysql"
)

PORT = getenv("PORT") or"8080"
HOME = getenv("HOME")
wp_cli_version = getenv("SHIPIT_WPCLI_VERSION")
if wp_cli_version:
    wp_cli_download_url = f"https://github.com/wp-cli/wp-cli/releases/download/v{wp_cli_version}/wp-cli-{wp_cli_version}.phar"
else:
    wp_cli_download_url = "https://raw.githubusercontent.com/wp-cli/builds/gh-pages/phar/wp-cli.phar"


serve(
  name="php-wordpress",
  provider="php",
  cwd=app["serve"],
  build=[
    use(php),
    copy(wp_cli_download_url, "{}/wp-cli.phar".format(assets["build"])),
    copy("wordpress/install.sh", "{}/wordpress-install.sh".format(assets["build"]), base="assets"),
    copy("wordpress/wp-config.php", "{}/wp-config.php".format(app["build"]), base="assets"),
    workdir(app["build"]),
    copy("php/php.ini", "{}/php.ini".format(assets["build"]), base="assets"),
    copy(".", ".", ignore=[".git"])
  ],
  deps=[php, bash],
  env = {
    "PAGER": "cat",
    "PHP_INI_SCAN_DIR": "{}".format(assets["serve"])
  },
  commands = {
    "wp": "php {}/wp-cli.phar --allow-root --path={}".format(assets["serve"], app["serve"]).replace("$PORT", PORT),
    "after_deploy": "bash {}/wordpress-install.sh".format(assets["serve"]).replace("$PORT", PORT),
    "start": "php -S localhost:{} -t {}".format(PORT, app["serve"]).replace("$PORT", PORT)
  },
  services=[
    database,
  ],
  mounts=[
    app,
    assets
  ],
  volumes=[
    wp_content
  ],
)
