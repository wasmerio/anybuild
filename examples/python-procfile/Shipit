python = dep("python", metadata.python_version)
uv = dep("uv", metadata.uv_version)

app = mount("app")
venv = mount("venv")
local_venv = mount("local_venv")

python_version = metadata.python_version
cross_platform = metadata.cross_platform
python_extra_index_url = metadata.python_extra_index_url
precompile_python = metadata.precompile_python
python_cross_packages_path = venv["build"] + f"/lib/python{python_version}/site-packages"
python_serve_site_packages_path = "{}/lib/python{}/site-packages".format(venv["serve"], python_version)
app_serve_path = app["serve"]


serve(
  name="python-procfile",
  provider="python",
  cwd=app["serve"],
  build=[
    use(python, uv),
    workdir(app["build"]),
    path((local_venv["build"] if cross_platform else venv["build"]) + "/bin"),
    copy(".", ".", ignore=[".venv", ".git", "__pycache__"])
  ],
  deps=[python],
  prepare=[
    run("echo \"Precompiling Python code...\"") if precompile_python else None,
    run(f"python -m compileall -o 2 {python_serve_site_packages_path} || true") if precompile_python else None,
    run("echo \"Precompiling package code...\"") if precompile_python else None,
    run(f"python -m compileall -o 2 {app_serve_path} || true") if precompile_python else None
  ],
  env = {
    "PYTHONPATH": f"{app_serve_path}:{python_serve_site_packages_path}",
    "HOME": app["serve"]
  },
  commands = {
    "start": (metadata.commands.start or None).replace("$PORT", PORT)
  },
  mounts=[
    app,
    venv
  ],
)
