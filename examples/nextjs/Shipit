node_version = getenv("SHIPIT_NODE_VERSION") or "22"
node = dep("node", node_version)
npm_version = getenv("SHIPIT_NPM_VERSION")
npm = dep("npm", npm_version)
staticwebserver = dep("static-web-server")

temp = mount("temp")

app = mount("app")

PORT = getenv("PORT") or "8080"

serve(
  name="nextjs",
  provider="node-static",
  cwd=app["serve"],
  build=[
    use(node, npm),
    workdir(temp["build"]),
    run("npm ci", inputs=["package.json", "package-lock.json"], group="install"),
    copy(".", ".", ignore=["node_modules", ".git"]),
    run("npm run build", outputs=["out"], group="build"),
    run("cp -R out/* {}/".format(app["build"]))
  ],
  deps=[staticwebserver],
  commands = {
    "start": "static-web-server --root={} --log-level=info --port={}".format(app["serve"], PORT).replace("$PORT", PORT)
  },
  mounts=[
    app
  ],
)
