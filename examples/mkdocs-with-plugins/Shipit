python_version = getenv("SHIPIT_PYTHON_VERSION") or "3.13"
python = dep("python", python_version)
uv_version = getenv("SHIPIT_UV_VERSION") or "0.8.15"
uv = dep("uv", uv_version)
staticwebserver_version = getenv("SHIPIT_SWS_VERSION") or "2.38.0"
staticwebserver = dep("static-web-server", staticwebserver_version)

app = mount("app")
local_venv = mount("local_venv")
mkdocs_version = getenv("SHIPIT_MKDOCS_VERSION") or "1.6.1"
cross_platform = getenv("SHIPIT_PYTHON_CROSS_PLATFORM")
venv = local_venv


serve(
  name="mkdocs-with-plugins",
  provider="mkdocs-site",
  cwd=app["serve"],
  build=[
    use(python, uv),
    env(UV_PROJECT_ENVIRONMENT=local_venv["build"] if cross_platform else venv["build"]),
    run(f"uv init --no-workspace --no-managed-python --python python{python_version}", inputs=[], outputs=["uv.lock"], group="install"),
    run("uv add -r requirements.txt mkdocs", inputs=["requirements.txt"], group="install"),
    path((local_venv["build"] if cross_platform else venv["build"]) + "/bin"),
    copy(".", ".", ignore=[".venv", ".git", "__pycache__"]),
    run("uv run mkdocs build --site-dir={}".format(app["build"]), outputs=["."], group="build")
  ],
  deps=[python, staticwebserver],
  env = {},
  commands = {
    "start": "static-web-server --root={} --log-level=info --port=8080".format(app["serve"])
  },
  mounts=[
    app
  ],
)
