---
const title = "Astro Node Example";
const renderedAt = new Date().toISOString();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <h1>{title}</h1>
      <p>Rendered by Astro on Node.</p>
      <time datetime={renderedAt}>{renderedAt}</time>
    </main>
  </body>
</html>
