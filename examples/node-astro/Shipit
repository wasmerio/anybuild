node = dep("node", config.node_version)
npm = dep("npm", config.npm_version)

build = mount("build")
app = mount("app")

serve(
  name="node-astro",
  provider="node",
  cwd=app.serve_path,
  build=[
    use(node, npm),
    workdir(build.path),
    copy("package-lock.json"),
    env(CI="true", NPM_CONFIG_FUND="false"),
    run("npm install", inputs=["package.json"], group="install"),
    copy(".", ignore=["node_modules", ".git", "package-lock.json"]),
    run("npm run build", outputs=["."], group="build"),
    run("npm prune --omit=dev --ignore-scripts", group="prune"),
    run("npx -y optimize-deps@0.1.1 dist --replace"),
    run("cp -R . {}".format(app.path))
  ],
  deps=[node],
  env = {},
  commands = {
    "start": "node ./dist/server/entry.mjs"
  },
  mounts=[
    app
  ],
)
